#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
python=.venv/bin/python
[ -x "$python" ] || python=python3
export PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
unset PYTEST_ADDOPTS PYTEST_PLUGINS
unset ROLLOUTDIFF_ARIA_PATH ROLLOUTDIFF_TRL_DIR ROLLOUTDIFF_FULL_ARIA
unset ROLLOUTDIFF_EXTERNAL_SOURCES ROLLOUTDIFF_METRICS_PATH

echo "pre-push: running fast tests (local datasets and external snapshots excluded)"
if ! "$python" -m pytest -q -m 'not local_data' -p no:cacheprovider; then
    echo "pre-push: fast tests failed" >&2
    exit 1
fi
